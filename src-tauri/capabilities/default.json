{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and remote-server windows",
  "windows": [
    "main",
    "server-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "deep-link:default",
    "dialog:default",
    "dialog:allow-open",
    "opener:default",
    "opener:allow-open-path",
    "sql:default",
    "sql:allow-execute",
    "notification:default",
    "updater:default",
    "process:default"
  ]
}
