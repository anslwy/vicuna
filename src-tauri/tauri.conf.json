{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vicuna",
  "version": "0.0.6",
  "identifier": "com.vicuna.app",
  "build": {
    "beforeDevCommand": "scripts/desktop-dev.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Vicuna",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRkVBOUZDMjk0RUY4OTIKUldTUytFNHAvS24rY0VHUjZnWmdGRmkwVnVTN2JXdE5Udjk4N2dWWUNLcjlXcVBnbDh1d0dDamoK",
      "endpoints": [
        "https://github.com/anslwy/vicuna/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["vicuna"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["lb-sidecar/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
